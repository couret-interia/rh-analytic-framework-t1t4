# ─────────────────────────────
#  1. LaTeX build artefacts
# ─────────────────────────────
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.pdfsync
*.ps
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.run.xml
*.synctex(busy)

# ─────────────────────────────
#  2. latexmk / temporary dirs
# ─────────────────────────────
_build/
out/
build/
tmp/
cache/
logs/

# ─────────────────────────────
#  3. Python / pre-commit caches
# ─────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.mypy_cache/
.pytest_cache/
.tox/
.venv/
venv/
*.egg-info/
dist/
artifacts/

# ─────────────────────────────
#  4. OS-specific artefacts
# ─────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# ─────────────────────────────
#  5. Archives and bundles
# ─────────────────────────────
*.zip
*.tar
*.tar.gz
*.7z

# ─────────────────────────────
#  6. Logs / CI temp files
# ─────────────────────────────
*.log
*.tmp
*.bak
*.swp
*.swo

# ─────────────────────────────
#  7. Exceptions — keep the canonical artefacts
# ─────────────────────────────
!src/main_journal.pdf
!src/main_journal_FR.pdf
!dist/main_journal_FR.pdf.sha256
!docs/explication-grand-format/latex/graphe_dependances_standalone.pdf
!docs/explication-grand-format/latex/graphe_dependances_dark.pdf
!docs/explication-grand-format/latex/graphe_dependances_dark.png
!README.md
!LICENSE
!zenodo.json
!CHANGELOG.md

# ─────────────────────────────
#  8. Prevent memo bulded pdf
# ─────────────────────────────
audits/memo/*.pdf

# ─────────────────────────────
#  9. Ignore editor backups
# ─────────────────────────────
*~
*.bak
*.orig
*.rej
*.tmp
